# Database (Supabase Postgres)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard/onboarding

# Admin Access (comma-separated emails)
ADMIN_EMAILS=virmanimayank15@gmail.com

# Shopify OAuth (Automatic Connect flow)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,read_customers,read_checkouts,write_checkouts,read_product_listings
SHOPIFY_APP_URL=http://localhost:3000
SHOPIFY_ALLOW_CART_WITHOUT_PHONE=

# Token encryption (32-byte hex key for AES-256)
ENCRYPTION_KEY=

# Tough Tongue AI — SIP dispatch + webhooks
TT_API_KEY=
TT_ORG_ID=
TT_BASE_URL=https://api.toughtongueai.com/api/public
# Signing secret shown when you create the TTAI webhook endpoint (Standard Webhooks)
TTAI_WEBHOOK_SECRET=

# uAgents context enrichment (shopify.gs)
UAGENTS_CUSTOMER_NAME=ttai
UAGENTS_TOKEN=
UAGENTS_BASE_URL=https://uagents.val.run

# Cron — auto-call processor (optional external scheduler)
CRON_SECRET=

# Google Sheets write-back for the Drafts module
# Share the target sheet with the service account as Editor
# Prefer a local JSON file (Next.js cannot parse multiline JSON in .env)
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./google-service-account.json
# Or a single-line JSON string:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}
# Or instead of JSON:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Dodo Payments — one-time top-up checkout only (credits managed in-app)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_TOPUP_PRODUCT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000
