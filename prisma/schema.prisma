generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CheckoutSyncMode {
  WEBHOOK
  POLLING
  SHEET
}

enum SheetSyncDirection {
  TOP
  BOTTOM
}

model Store {
  id               String              @id @default(uuid())
  storeDomain      String              @unique
  /** Shopify shop display name (e.g. "Acme Store"), fetched from Admin API after connect. */
  name             String?
  apiKey           String?
  apiSecret        String?
  adminAccessToken String
  storefrontToken  String
  callDelayMinutes Int                 @default(30)
  sipConcurrency   Int                 @default(1)
  checkoutSyncMode CheckoutSyncMode    @default(POLLING)
  /** Public Google Sheet / CSV export URL for plugin abandoned-checkout rows. */
  sheetUrl         String              @default("") @db.Text
  /** Whether sheet sync reads from the top (oldest) or bottom (newest) of the sheet. */
  sheetSyncDirection SheetSyncDirection @default(BOTTOM)
  lastSheetSyncAt  DateTime?
  /** Other *.myshopify.com hosts for the same shop (Shopify sends webhooks on any of them). */
  alternateShopDomains String[]        @default([])
  ttaiScenarioId   String?
  ttaiTrunkId      String?
  /** Public Google Sheet / CSV export URL for NDRC (non-delivery confirmation) orders. */
  ndrcSheetUrl         String             @default("") @db.Text
  ndrcSheetSyncDirection SheetSyncDirection @default(BOTTOM)
  /** Only sync sheet rows with attempts >= this value. */
  ndrcMinAttempts      Int                @default(1)
  lastNdrcSheetSyncAt  DateTime?
  ndrcTtaiScenarioId   String?
  ndrcTtaiTrunkId      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  checkouts        AbandonedCheckout[]
  ndrcOrders       NdrcOrder[]
}

model AbandonedCheckout {
  id                String        @id @default(uuid())
  checkoutToken     String        @unique
  shopifyCheckoutId String?       @unique
  customerPhone     String        @default("")
  customerEmail     String?
  cartValue         Float         @default(0)
  cartId            String        @default("")
  checkoutUrl       String        @default("") @db.Text
  draftOrderId      String        @default("")
  draftOrderName    String        @default("")
  recoveryUrl       String        @default("") @db.Text
  lineItemsJson     Json          @default("[]")
  orderContext      String        @default("") @db.Text
  userContext       String        @default("") @db.Text
  relatedItems      Json          @default("[]")
  callScheduled     Boolean       @default(false)
  scheduledCallAt   DateTime?
  shopifyCreatedAt  DateTime?
  callStatus        CallStatus    @default(PENDING)
  lastError         String?       @db.Text
  sessionId         String?
  aiSummary         String?       @db.Text
  storeDomain       String
  store             Store         @relation(fields: [storeDomain], references: [storeDomain], onDelete: Cascade)
  callAttempts      CallAttempt[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([storeDomain])
  @@index([callStatus])
  @@index([scheduledCallAt])
}

model CallAttempt {
  id                  String            @id @default(uuid())
  abandonedCheckoutId String
  checkout            AbandonedCheckout @relation(fields: [abandonedCheckoutId], references: [id], onDelete: Cascade)
  callId              String?
  sessionId           String?
  status              CallStatus        @default(PREPARING)
  failureStage        String?
  failureReason       String?           @db.Text
  transcript          String?           @db.Text
  toolCallsJson       Json              @default("[]")
  dynamicVarsJson     Json              @default("{}")
  trigger             String            @default("manual")
  startedAt           DateTime          @default(now())
  endedAt             DateTime?
  durationSec         Int?

  @@index([abandonedCheckoutId])
  @@index([callId])
  @@index([sessionId])
  @@index([status])
}

enum CallStatus {
  PENDING
  PREPARING
  DISPATCHED
  COMPLETED
  NO_ANSWER
  BUSY
  INVALID_NUMBER
  HANG_UP
  VOICEMAIL
  CART_CREATE_FAILED
  DRAFT_CREATE_FAILED
  ENRICH_FAILED
  DISPATCH_FAILED
}

/** NDRC = Non-Delivery Report Confirmation. Sheet-sourced orders with failed
 * delivery attempt(s), called manually to confirm/redeliver/cancel. */
model NdrcOrder {
  id              String            @id @default(uuid())
  /** Order id / name / AWB from the sheet — unique per store. */
  orderId         String
  customerPhone   String            @default("")
  customerEmail   String?
  orderValue      Float             @default(0)
  /** Number of failed delivery attempts, from the sheet. */
  attempts        Int               @default(0)
  courierName     String            @default("")
  awbNumber       String            @default("")
  /** Raw sheet context (shipping address, etc.) — same shape as AbandonedCheckout.userContext. */
  userContext     String            @default("") @db.Text
  callStatus      CallStatus        @default(PENDING)
  lastError       String?           @db.Text
  sessionId       String?
  storeDomain     String
  store           Store             @relation(fields: [storeDomain], references: [storeDomain], onDelete: Cascade)
  callAttempts    NdrcCallAttempt[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([storeDomain, orderId])
  @@index([storeDomain])
  @@index([callStatus])
}

model NdrcCallAttempt {
  id              String     @id @default(uuid())
  ndrcOrderId     String
  order           NdrcOrder  @relation(fields: [ndrcOrderId], references: [id], onDelete: Cascade)
  callId          String?
  sessionId       String?
  status          CallStatus @default(PREPARING)
  failureStage    String?
  failureReason   String?    @db.Text
  transcript      String?    @db.Text
  toolCallsJson   Json       @default("[]")
  dynamicVarsJson Json       @default("{}")
  trigger         String     @default("manual")
  startedAt       DateTime   @default(now())
  endedAt         DateTime?
  durationSec     Int?

  @@index([ndrcOrderId])
  @@index([callId])
  @@index([sessionId])
  @@index([status])
}
